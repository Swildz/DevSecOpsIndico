# Example Terraform Variables file for Staging/Production Deployment
# Copy to terraform.tfvars and populate with environment-specific values.

aws_region  = "ap-southeast-1"
environment = "production"
project_name= "indico-api"

vpc_cidr                 = "10.0.0.0/16"
public_subnet_cidrs      = ["10.0.1.0/24", "10.0.2.0/24"]
private_app_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24"]
isolated_db_subnet_cidrs = ["10.0.20.0/24", "10.0.21.0/24"]

container_port     = 8080
desired_task_count = 2

github_repository  = "indico-org/devsecops-backend-api"

common_tags = {
  Project      = "indico-api"
  Environment  = "production"
  ManagedBy    = "Terraform"
  Compliance   = "PCI-DSS-Ready"
  SecurityTier = "Confidential"
}
